    <AppDomain>https://github.com</AppDomain>
    <AppDomain>http://localhost:3000</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="http://localhost:3000/src/dialog/dialog.html?v=v1.3.2&amp;exp=ribbon-mac-1"/>
  </DefaultSettings>
