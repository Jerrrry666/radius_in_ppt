#!/bin/bash
#
# RadiusInPpt — .app 启动脚本（Office Add-in 路线，纯前端版）
#
# 行为：
#   1. 找到 .app/Contents/Resources/ 下的源文件
#   2. 找 node（兼容 launchd 的精简 PATH）
#   3. 后台启动 node server（http://localhost:3000，serve.js）
#   4. 复制 manifest.xml 到
#      ~/Library/Containers/com.microsoft.Powerpoint/Data/Documents/wef
#      （Microsoft 官方 Mac Office Add-in 加载路径）
#   5. 弹引导对话框，提示用户完全退出 PowerPoint (Cmd+Q) 后重新打开
#
# 注意：所有 .pptx 读写都通过 Office.js 在 PowerPoint 进程内完成，
#      这个 server 只负责给 dialog 提供 HTML/JS/CSS 静态资源。
#
# i18n: 检测系统语言（zh / en），弹相应文案。
#
set -u

# ---------- 1. 路径 ----------
APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
RES_DIR="$APP_DIR/Resources"
MANIFEST="$RES_DIR/manifest.xml"
SERVER_JS="$RES_DIR/tools/serve.js"
LOG_FILE="/tmp/radius_in_ppt.log"
PID_FILE="/tmp/radius_in_ppt.pid"
WEF_DIR="$HOME/Library/Containers/com.microsoft.Powerpoint/Data/Documents/wef"

# ---------- 1.5 系统语言检测 ----------
detect_lang() {
  # osascript 'user locale of (system info)' returns e.g. "zh_CN" / "en_US"
  local loc
  loc="$(osascript -e 'user locale of (system info)' 2>/dev/null || echo 'en_US')"
  case "$loc" in
    zh*) echo "zh" ;;
    *)   echo "en" ;;
  esac
}
LANG_CODE="$(detect_lang)"

# ---------- 文案表 ----------
APP_TITLE_ZH="R 角调整"
APP_TITLE_EN="RadiusInPpt"

if [ "$LANG_CODE" = "zh" ]; then
  MSG_NO_NODE_TITLE="$APP_TITLE_ZH"
  MSG_NO_NODE_BODY="没找到 Node.js（需要 18+）。

R 角调整需要 Node.js 跑一个轻量静态文件 server。

最简单的安装方式：Terminal 跑下面这一行
    brew install node

或者访问 https://nodejs.org/ 下载 LTS 安装包。"
  MSG_NO_NODE_BTN="打开 Node.js 官网"

  MSG_SERVER_FAIL_TITLE="$APP_TITLE_ZH"
  MSG_SERVER_FAIL_BODY="启动 server 失败，请查看 /tmp/radius_in_ppt.log"
  MSG_SERVER_FAIL_BTN="好的"

  # PowerPoint 在跑
  MSG_READY_PP_TITLE="$APP_TITLE_ZH"
  MSG_READY_PP_BODY="✅ R 角调整 已就位

静态 server 已启动（http://localhost:3000）
manifest 已复制到 wef 目录。

但你得**完全退出 PowerPoint（Cmd + Q，不要只关窗口）后重新打开**，新加载项才会生效。

之后每次使用只需双击本 App。"
  MSG_READY_PP_BTN_QUIT="退出并重新打开 PowerPoint"
  MSG_READY_PP_BTN_SHOW="在 Finder 中显示 manifest"
  MSG_READY_PP_BTN_DONE="完成"

  # PowerPoint 没在跑
  MSG_READY_NOPP_TITLE="$APP_TITLE_ZH"
  MSG_READY_NOPP_BODY="✅ R 角调整 已就位

静态 server 已启动（http://localhost:3000）
manifest 已复制到 wef 目录。

PowerPoint 启动后会在 ribbon 看到「R 角调整」tab。"
  MSG_READY_NOPP_BTN_OPEN="打开 PowerPoint"
  MSG_READY_NOPP_BTN_DONE="完成"
else
  MSG_NO_NODE_TITLE="$APP_TITLE_EN"
  MSG_NO_NODE_BODY="Node.js (18+) was not found.

RadiusInPpt needs Node.js to run a small static file server.

Easiest install: run this in Terminal
    brew install node

Or grab the LTS installer from https://nodejs.org/."
  MSG_NO_NODE_BTN="Open nodejs.org"

  MSG_SERVER_FAIL_TITLE="$APP_TITLE_EN"
  MSG_SERVER_FAIL_BODY="Failed to start the server. See /tmp/radius_in_ppt.log for details."
  MSG_SERVER_FAIL_BTN="OK"

  MSG_READY_PP_TITLE="$APP_TITLE_EN"
  MSG_READY_PP_BODY="✅ RadiusInPpt is ready.

Static server started (http://localhost:3000).
Manifest copied to the wef directory.

**Fully quit PowerPoint (Cmd + Q, not just close the window) and reopen it** for the new add-in to load.

After that, just double-click this App to start."
  MSG_READY_PP_BTN_QUIT="Quit and reopen PowerPoint"
  MSG_READY_PP_BTN_SHOW="Show manifest in Finder"
  MSG_READY_PP_BTN_DONE="Done"

  MSG_READY_NOPP_TITLE="$APP_TITLE_EN"
  MSG_READY_NOPP_BODY="✅ RadiusInPpt is ready.

Static server started (http://localhost:3000).
Manifest copied to the wef directory.

When PowerPoint starts, you'll see the 'RadiusInPpt' tab on the ribbon."
  MSG_READY_NOPP_BTN_OPEN="Open PowerPoint"
  MSG_READY_NOPP_BTN_DONE="Done"
fi

# ---------- 2. 找 node ----------
find_node() {
  if command -v node >/dev/null 2>&1; then
    command -v node
    return 0
  fi
  local candidates=(
    "/opt/homebrew/bin/node"
    "/usr/local/bin/node"
    "/opt/local/bin/node"
    "/usr/bin/node"
  )
  for c in "${candidates[@]}"; do
    if [ -x "$c" ]; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

NODE_BIN="$(find_node || true)"
if [ -z "$NODE_BIN" ]; then
  osascript -e "display dialog \"$MSG_NO_NODE_BODY\" buttons {\"$MSG_NO_NODE_BTN\"} default button \"$MSG_NO_NODE_BTN\" with title \"$MSG_NO_NODE_TITLE\" with icon stop" 2>/dev/null || true
  open "https://nodejs.org/" >/dev/null 2>&1 || true
  exit 1
fi
echo "[RadiusInPpt] using node: $NODE_BIN ($($NODE_BIN --version 2>&1))"

# ---------- 3. 检查端口 ----------
is_port_in_use() {
  lsof -ti tcp:3000 -sTCP:LISTEN >/dev/null 2>&1
}

if [ -f "$PID_FILE" ]; then
  OLD_PID=$(cat "$PID_FILE" 2>/dev/null || true)
  if [ -n "$OLD_PID" ] && ! kill -0 "$OLD_PID" 2>/dev/null; then
    rm -f "$PID_FILE"
  fi
fi

EXISTING_MODE=0
if is_port_in_use; then
  RUNNING_PID=$(lsof -ti tcp:3000 -sTCP:LISTEN | head -1)
  echo "[RadiusInPpt] server 已经在端口 3000 上运行（PID $RUNNING_PID）"
  EXISTING_MODE=1
fi

# ---------- 4. 启动 server ----------
start_server() {
  cd "$RES_DIR" || exit 1
  nohup "$NODE_BIN" "$SERVER_JS" >> "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 2
  if is_port_in_use; then
    echo "[RadiusInPpt] server 启动成功 (PID $(cat "$PID_FILE"))"
    return 0
  else
    echo "[RadiusInPpt] server 启动失败，日志：$LOG_FILE"
    return 1
  fi
}

if [ "$EXISTING_MODE" = "0" ]; then
  if ! start_server; then
    osascript -e "display dialog \"$MSG_SERVER_FAIL_BODY\" buttons {\"$MSG_SERVER_FAIL_BTN\"} default button \"$MSG_SERVER_FAIL_BTN\" with title \"$MSG_SERVER_FAIL_TITLE\" with icon stop" 2>/dev/null
    exit 1
  fi
fi

# ---------- 5. 复制 manifest 到 wef ----------
# Cmd+Q 后 macOS 可能回收沙盒目录，所以无条件创建
ADDIN_INSTALLED=0
mkdir -p "$WEF_DIR"
cp -f "$MANIFEST" "$WEF_DIR/manifest.xml"
if [ $? -eq 0 ]; then
  ADDIN_INSTALLED=1
  echo "[RadiusInPpt] manifest 已复制到 $WEF_DIR"
fi
# PowerPoint 是否在跑（决定后续弹什么窗）
PP_RUNNING=0
if pgrep -f "Microsoft PowerPoint" >/dev/null 2>&1; then
  PP_RUNNING=1
fi

# ---------- 6. 弹引导对话框 ----------
# PowerPoint 在跑：要求 Cmd+Q + 重开 让新 manifest 生效
# PowerPoint 没在跑：直接帮他开
if [ "$PP_RUNNING" = "1" ]; then
  DIALOG_RESULT=$(osascript -e "set theChoice to button returned of (display dialog \"$MSG_READY_PP_BODY\" buttons {\"$MSG_READY_PP_BTN_QUIT\", \"$MSG_READY_PP_BTN_SHOW\", \"$MSG_READY_PP_BTN_DONE\"} default button \"$MSG_READY_PP_BTN_QUIT\" with title \"$MSG_READY_PP_TITLE\")
return theChoice" 2>/dev/null)
else
  DIALOG_RESULT=$(osascript -e "set theChoice to button returned of (display dialog \"$MSG_READY_NOPP_BODY\" buttons {\"$MSG_READY_NOPP_BTN_OPEN\", \"$MSG_READY_NOPP_BTN_DONE\"} default button \"$MSG_READY_NOPP_BTN_OPEN\" with title \"$MSG_READY_NOPP_TITLE\")
return theChoice" 2>/dev/null)
fi

# ---------- 7. 处理用户选择 ----------
# 用 case 匹配本地化的按钮文案（zh / en 都覆盖）
case "$DIALOG_RESULT" in
  "$MSG_READY_PP_BTN_QUIT")
    pkill -x "Microsoft PowerPoint" 2>/dev/null || true
    sleep 1
    if [ -d "/Applications/Microsoft PowerPoint.app" ]; then
      open -a "Microsoft PowerPoint"
    else
      open -a "PowerPoint" 2>/dev/null || true
    fi
    ;;
  "$MSG_READY_PP_BTN_SHOW")
    if [ -f "$MANIFEST" ]; then
      osascript -e "tell application \"Finder\" to reveal POSIX file \"$MANIFEST\"" 2>/dev/null
      osascript -e 'tell application "Finder" to activate' 2>/dev/null
    fi
    ;;
  *)
    # "完成" / "Done" 或取消
    ;;
esac

exit 0
