#!/bin/bash
#
# RadiusInPpt — .app 启动脚本
#
# 行为：
#   1. 找到 .app/Contents/Resources/
#   2. 检查 node
#   3. 检查端口 3000 是否已被占用
#   4. 后台启动 node server
#   5. 弹引导对话框（osascript），让用户选下一步
#   6. 根据用户选择：打开 PowerPoint / 在 Finder 中显示 manifest.xml
#   7. 持续监控 server 进程（用户可点 .app 再次进入对话框）
#
set -u

# ---------- 1. 路径 ----------
APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
RES_DIR="$APP_DIR/Resources"
MANIFEST="$RES_DIR/manifest.xml"
SERVER_JS="$RES_DIR/tools/serve.js"
LOG_FILE="/tmp/radius_in_ppt.log"
PID_FILE="/tmp/radius_in_ppt.pid"

# ---------- 2. 找 node（macOS 双击 .app 时 PATH 不包含 /opt/homebrew/bin）----------

find_node() {
  # 1. 先看 PATH
  if command -v node >/dev/null 2>&1; then
    command -v node
    return 0
  fi
  # 2. 常见安装位置（按优先级）
  local candidates=(
    "/opt/homebrew/bin/node"            # Apple Silicon Homebrew
    "/usr/local/bin/node"                # Intel Homebrew / pkg 安装
    "/opt/local/bin/node"                # MacPorts
    "$HOME/.nvm/versions/node/$(ls -1 "$HOME/.nvm/versions/node" 2>/dev/null | tail -1)/bin/node"  # nvm 默认版本
    "/usr/bin/node"                      # 几乎不存在，留个兜底
  )
  for c in "${candidates[@]}"; do
    if [ -x "$c" ]; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

NODE_BIN="$(find_node || true)"
if [ -z "$NODE_BIN" ]; then
  osascript <<'EOF' 2>/dev/null || true
display dialog "没找到 Node.js（需要 18+）。

R 角调整的 server 用 Node.js 跑。

最简单的安装方式：Terminal 跑下面这一行
    brew install node

或者访问 https://nodejs.org/ 下载 LTS 安装包。" buttons {"打开 Node.js 官网"} default button "打开 Node.js 官网" with title "R 角调整" with icon stop
EOF
  open "https://nodejs.org/" >/dev/null 2>&1 || true
  exit 1
fi
echo "[RadiusInPpt] using node: $NODE_BIN ($($NODE_BIN --version 2>&1))"

# ---------- 3. 检查端口 ----------
is_port_in_use() {
  lsof -ti tcp:3000 -sTCP:LISTEN >/dev/null 2>&1
}

# 清理已死进程（上次崩溃可能留 stale pid）
if [ -f "$PID_FILE" ]; then
  OLD_PID=$(cat "$PID_FILE" 2>/dev/null || true)
  if [ -n "$OLD_PID" ] && ! kill -0 "$OLD_PID" 2>/dev/null; then
    rm -f "$PID_FILE"
  fi
fi

if is_port_in_use; then
  RUNNING_PID=$(lsof -ti tcp:3000 -sTCP:LISTEN | head -1)
  cat <<EOF
[RadiusInPpt] server 已经在端口 3000 上运行（PID $RUNNING_PID）
EOF
  EXISTING_MODE=1
else
  EXISTING_MODE=0
fi

# ---------- 4. 启动 server ----------
start_server() {
  cd "$RES_DIR" || exit 1
  nohup "$NODE_BIN" "$SERVER_JS" >> "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 2
  if is_port_in_use; then
    echo "[RadiusInPpt] server 启动成功 (PID $(cat "$PID_FILE"))"
    return 0
  else
    echo "[RadiusInPpt] server 启动失败，日志：$LOG_FILE"
    return 1
  fi
}

if [ "$EXISTING_MODE" = "0" ]; then
  if ! start_server; then
    osascript <<'EOF' 2>/dev/null
display dialog "启动 server 失败，请查看 /tmp/radius_in_ppt.log" buttons {"好的"} default button "好的" with title "R 角调整" with icon stop
EOF
    exit 1
  fi
fi

# ---------- 4.5. 自动注册 manifest 到 PowerPoint 加载项目录 ----------
# Mac Office 加载 Office Add-in 的官方持久化方式：把 manifest 复制到
# ~/Library/Containers/com.microsoft.Powerpoint/Data/Library/Application Support/Microsoft/AddIns/
# 重启 PowerPoint 后会自动加载。无需走 UI 菜单。
ADDIN_DIR="$HOME/Library/Containers/com.microsoft.Powerpoint/Data/Library/Application Support/Microsoft/AddIns"
ADDIN_INSTALLED=0
if [ -d "$HOME/Library/Containers/com.microsoft.Powerpoint" ]; then
  mkdir -p "$ADDIN_DIR"
  # 始终覆盖，保证版本一致
  cp -f "$MANIFEST" "$ADDIN_DIR/manifest.xml"
  if [ $? -eq 0 ]; then
    ADDIN_INSTALLED=1
  fi
fi

# ---------- 5. 弹引导对话框 ----------
# 这里用 osascript 阻塞，等用户操作
DIALOG_RESULT=$(osascript <<EOF
set theResult to ""
try
  if $ADDIN_INSTALLED = 1 then
    set theChoice to button returned of (display dialog "✅ R 角调整 已就位

已自动把 manifest 注册到 PowerPoint 加载项目录。

下一步：
1. 完全退出 PowerPoint（Cmd + Q，不要只关窗口）
2. 重新打开 PowerPoint
3. 顶部 ribbon 会出现「R 角调整」tab

之后每次使用只需双击本 App 即可。" buttons {"退出并重新打开 PowerPoint", "完成"} default button "退出并重新打开 PowerPoint" with title "R 角调整")
  else
    set theChoice to button returned of (display dialog "✅ R 角调整 server 已启动

但未检测到 PowerPoint 安装。

如果已安装 PowerPoint：
1. 完全退出 PowerPoint（Cmd + Q）
2. 重新打开 PowerPoint
3. 顶部 ribbon 会出现「R 角调整」tab" buttons {"完成"} default button "完成" with title "R 角调整")
  end if
  set theResult to theChoice
on error
  set theResult to "完成"
end try
return theResult
EOF
)

# ---------- 6. 处理用户选择 ----------
case "$DIALOG_RESULT" in
  "退出并重新打开 PowerPoint")
    # 关闭 PowerPoint（如果是运行的）
    pkill -x "Microsoft PowerPoint" 2>/dev/null || true
    sleep 1
    # 重新打开
    if [ -d "/Applications/Microsoft PowerPoint.app" ]; then
      open -a "Microsoft PowerPoint"
    else
      open -a "PowerPoint" 2>/dev/null || true
    fi
    ;;
  "打开 PowerPoint")
    if [ -d "/Applications/Microsoft PowerPoint.app" ]; then
      open -a "Microsoft PowerPoint"
    else
      osascript -e 'tell application "PowerPoint" to activate' 2>/dev/null || open -a "PowerPoint"
    fi
    ;;
  "在 Finder 中显示 manifest.xml")
    if [ -f "$MANIFEST" ]; then
      osascript -e "tell application \"Finder\" to reveal POSIX file \"$MANIFEST\"" 2>/dev/null
      osascript -e 'tell application "Finder" to activate' 2>/dev/null
    fi
    ;;
  *)
    # "完成" 或取消，什么都不做
    ;;
esac

# ---------- 7. 退出 ----------
# server 继续在后台跑（用户用完 PPT 后可以再次点 .app 弹引导框）
# 如需停止 server：在 Terminal 里跑 `lsof -ti tcp:3000 | xargs kill`
exit 0
