#!/bin/bash
#
# RadiusInPpt — .app 启动脚本（Office Add-in 路线）
#
# 行为：
#   1. 找到 .app/Contents/Resources/ 下的源文件
#   2. 找 node（兼容 launchd 的精简 PATH）
#   3. 后台启动 node server (http://localhost:3000)
#   4. 复制 manifest.xml 到
#      ~/Library/Containers/com.microsoft.Powerpoint/Data/Documents/wef
#      （Microsoft 官方 Mac Office Add-in 加载路径）
#   5. 弹引导对话框，提示用户完全退出 PowerPoint (Cmd+Q) 后重新打开
#
set -u

# ---------- 1. 路径 ----------
APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
RES_DIR="$APP_DIR/Resources"
MANIFEST="$RES_DIR/manifest.xml"
SERVER_JS="$RES_DIR/tools/serve.js"
LOG_FILE="/tmp/radius_in_ppt.log"
PID_FILE="/tmp/radius_in_ppt.pid"
WEF_DIR="$HOME/Library/Containers/com.microsoft.Powerpoint/Data/Documents/wef"

# ---------- 2. 找 node（macOS 双击 .app 时 PATH 不包含 /opt/homebrew/bin）----------

find_node() {
  if command -v node >/dev/null 2>&1; then
    command -v node
    return 0
  fi
  local candidates=(
    "/opt/homebrew/bin/node"
    "/usr/local/bin/node"
    "/opt/local/bin/node"
    "/usr/bin/node"
  )
  for c in "${candidates[@]}"; do
    if [ -x "$c" ]; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

NODE_BIN="$(find_node || true)"
if [ -z "$NODE_BIN" ]; then
  osascript <<'EOF' 2>/dev/null || true
display dialog "没找到 Node.js（需要 18+）。

R 角调整的 server 用 Node.js 跑。

最简单的安装方式：Terminal 跑下面这一行
    brew install node

或者访问 https://nodejs.org/ 下载 LTS 安装包。" buttons {"打开 Node.js 官网"} default button "打开 Node.js 官网" with title "R 角调整" with icon stop
EOF
  open "https://nodejs.org/" >/dev/null 2>&1 || true
  exit 1
fi
echo "[RadiusInPpt] using node: $NODE_BIN ($($NODE_BIN --version 2>&1))"

# ---------- 3. 检查端口 ----------
is_port_in_use() {
  lsof -ti tcp:3000 -sTCP:LISTEN >/dev/null 2>&1
}

# 清理已死进程
if [ -f "$PID_FILE" ]; then
  OLD_PID=$(cat "$PID_FILE" 2>/dev/null || true)
  if [ -n "$OLD_PID" ] && ! kill -0 "$OLD_PID" 2>/dev/null; then
    rm -f "$PID_FILE"
  fi
fi

if is_port_in_use; then
  RUNNING_PID=$(lsof -ti tcp:3000 -sTCP:LISTEN | head -1)
  echo "[RadiusInPpt] server 已经在端口 3000 上运行（PID $RUNNING_PID）"
  EXISTING_MODE=1
else
  EXISTING_MODE=0
fi

# ---------- 4. 启动 server ----------
start_server() {
  cd "$RES_DIR" || exit 1
  nohup "$NODE_BIN" "$SERVER_JS" >> "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 2
  if is_port_in_use; then
    echo "[RadiusInPpt] server 启动成功 (PID $(cat "$PID_FILE"))"
    return 0
  else
    echo "[RadiusInPpt] server 启动失败，日志：$LOG_FILE"
    return 1
  fi
}

# ---------- 4.5. 记下当前 PowerPoint .pptx 路径（给 server 用）----------
PPTX_PATH_FILE="/tmp/radius_in_ppt_pptx_path.txt"
detect_pptx() {
  local script='
  tell application "PowerPoint"
    try
      if not (exists active window) then return ""
      return full name of (presentation of active window)
    on error
      return ""
    end try
  end tell
  '
  local tmp
  tmp=$(mktemp /tmp/radius_in_ppt_as_XXXXXX.applescript)
  printf '%s' "$script" > "$tmp"
  local out
  out=$(/usr/bin/osascript "$tmp" 2>/dev/null | tr -d '\r\n')
  rm -f "$tmp"
  if [ -n "$out" ] && [ -f "$out" ]; then
    echo "$out" > "$PPTX_PATH_FILE"
    echo "[RadiusInPpt] recorded .pptx path: $out"
  fi
}
detect_pptx

if [ "$EXISTING_MODE" = "0" ]; then
  if ! start_server; then
    osascript <<'EOF' 2>/dev/null
display dialog "启动 server 失败，请查看 /tmp/radius_in_ppt.log" buttons {"好的"} default button "好的" with title "R 角调整" with icon stop
EOF
    exit 1
  fi
fi

# ---------- 5. 复制 manifest 到 wef 目录 ----------
# Microsoft 官方 Mac Office Add-in 加载路径
ADDIN_INSTALLED=0
if [ -d "$HOME/Library/Containers/com.microsoft.Powerpoint" ]; then
  mkdir -p "$WEF_DIR"
  cp -f "$MANIFEST" "$WEF_DIR/manifest.xml"
  if [ $? -eq 0 ]; then
    ADDIN_INSTALLED=1
    echo "[RadiusInPpt] manifest 已复制到 $WEF_DIR"
  fi
fi

# ---------- 6. 弹引导对话框 ----------
DIALOG_RESULT=$(osascript <<EOF
set theResult to ""
try
  if $ADDIN_INSTALLED = 1 then
    set theChoice to button returned of (display dialog "✅ R 角调整 已就位

服务器已启动（http://localhost:3000）
加载项已注册到 PowerPoint。

下一步：
1. 完全退出 PowerPoint（Cmd + Q，不要只关窗口）
2. 重新打开 PowerPoint
3. 点击顶部「主页」tab → 「加载项」
4. 在弹窗里选「R 角调整」
5. 顶部 ribbon 会出现「R 角调整」tab

之后每次使用只需双击本 App。" buttons {"退出并重新打开 PowerPoint", "在 Finder 中显示 manifest", "完成"} default button "退出并重新打开 PowerPoint" with title "R 角调整")
  else
    set theChoice to button returned of (display dialog "✅ R 角调整 server 已启动

但未检测到 PowerPoint 安装，无法自动注册加载项。

请手动操作：
1. 打开 Finder，按 Cmd + Shift + G
2. 输入：~/Library/Containers/com.microsoft.Powerpoint/Data/Documents/wef
3. 把 manifest.xml 拷到这个目录
4. 重启 PowerPoint" buttons {"好的"} default button "好的" with title "R 角调整")
  end if
  set theResult to theChoice
on error
  set theResult to "完成"
end try
return theResult
EOF
)

# ---------- 7. 处理用户选择 ----------
case "$DIALOG_RESULT" in
  "退出并重新打开 PowerPoint")
    pkill -x "Microsoft PowerPoint" 2>/dev/null || true
    sleep 1
    if [ -d "/Applications/Microsoft PowerPoint.app" ]; then
      open -a "Microsoft PowerPoint"
    else
      open -a "PowerPoint" 2>/dev/null || true
    fi
    ;;
  "在 Finder 中显示 manifest")
    if [ -f "$MANIFEST" ]; then
      osascript -e "tell application \"Finder\" to reveal POSIX file \"$MANIFEST\"" 2>/dev/null
      osascript -e 'tell application "Finder" to activate' 2>/dev/null
    fi
    ;;
  *)
    # "完成" 或取消
    ;;
esac

exit 0
